# === Jira ===
JIRA_BASE_URL=https://your-jira.example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=MYPROJECT
JIRA_USE_MOCK=true

# === Ollama ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === Rocket.Chat ===
ROCKETCHAT_BASE_URL=https://your-rocketchat.example.com
ROCKETCHAT_TOKEN=your_rc_auth_token
ROCKETCHAT_USER_ID=your_rc_user_id
ROCKETCHAT_CHANNEL=#general
ROCKETCHAT_USE_MOCK=true
