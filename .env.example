# === Jira ===
JIRA_BASE_URL=https://your-jira.example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_USE_MOCK=true
JIRA_JQL=status != Done ORDER BY created DESC
# optional, only for scripts/export_jira_labels.py
JIRA_LABELS_JQL=status != Done ORDER BY created DESC

# === Ollama ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === ticket_router_api ===
TICKET_ROUTER_BASE_URL=http://localhost:8080
